<Window x:Class="SmartCarSharingApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SmartCarSharingApp.UI.ViewModels"
        xmlns:views="clr-namespace:SmartCarSharingApp.UI.Views"
        mc:Ignorable="d"
        Title="Smart Car Sharing" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:RegisterViewModel}">
            <views:RegisterView />
        </DataTemplate>

        <!-- ДОДАНО: Шаблон для Дашборду -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <!-- ДОДАНО: Шаблон для Деталей -->
        <DataTemplate DataType="{x:Type viewmodels:CarDetailsViewModel}">
            <views:CarDetailsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F0F2F5">
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>