<UserControl x:Class="SmartCarSharingApp.UI.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:viewmodels="clr-namespace:SmartCarSharingApp.UI.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:RegisterViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="400">

    <Grid Background="#F5F5F5">
        <Border Background="White" 
                CornerRadius="10" 
                Padding="30" 
                Width="350" 
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Реєстрація" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <!-- Ім'я -->
                <TextBlock Text="Ім'я" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="0,0,0,15" Padding="5"/>

                <!-- Email -->
                <TextBlock Text="Електронна пошта" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="0,0,0,15" Padding="5"/>

                <!-- Пароль (Обробляється через події PasswordChanged) -->
                <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Height="30" Margin="0,0,0,15" Padding="5"/>

                <!-- Підтвердження пароля -->
                <TextBlock Text="Підтвердження пароля" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                             Height="30" Margin="0,0,0,20" Padding="5"/>

                <!-- Повідомлення про помилку -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="Red" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>

                <!-- Кнопка (Автоматично вимикається, якщо дані невалідні) -->
                <Button Content="Зареєструватися" 
                        Command="{Binding RegisterCommand}"
                        Height="35" 
                        Background="#007ACC" 
                        Foreground="White" 
                        FontSize="14" 
                        FontWeight="Bold"
                        Margin="0,0,0,15" Click="Button_Click"/>

                <!-- Навігація -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Вже маєте акаунт? " Foreground="Gray"/>
                    <TextBlock>
                        <Hyperlink Click="NavigateToLogin_Click">
                            Увійти
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>