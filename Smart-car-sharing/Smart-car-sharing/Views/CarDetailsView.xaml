<UserControl x:Class="SmartCarSharingApp.UI.Views.CarDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SmartCarSharingApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <d:UserControl.DataContext>
        <viewmodels:CarDetailsViewModel/>
    </d:UserControl.DataContext>

    <Grid Background="#F0F2F5">

        <Border Background="White" 
                CornerRadius="15" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Width="500"
                Padding="0">

            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="20" ShadowDepth="5" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                        Background="#E9EEF5" 
                        Height="250" 
                        CornerRadius="15,15,0,0"
                        ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="🚗" 
                                   FontSize="100" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Opacity="0.8"/>

                        <Border Background="#4CAF50" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Margin="20" 
                                CornerRadius="5" 
                                Padding="10,5">
                            <TextBlock Text="AVAILABLE" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="30,25,30,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Make}" FontSize="16" Foreground="Gray" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Model}" FontSize="28" FontWeight="Bold" Foreground="#333"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PriceFormatted}" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#007ACC"
                                   TextAlignment="Right"/>
                        <TextBlock Text="per hour" 
                                   FontSize="12" 
                                   Foreground="Gray" 
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="30,10,30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,10">
                        <Border Background="#F0F2F5" Width="40" Height="40" CornerRadius="10" Margin="0,0,15,0">
                            <TextBlock Text="📅" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Year" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding Year}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,10">
                        <Border Background="#F0F2F5" Width="40" Height="40" CornerRadius="10" Margin="0,0,15,0">
                            <TextBlock Text="📍" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Location" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding Location}" FontSize="16" FontWeight="SemiBold" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="2" VerticalAlignment="Bottom" Margin="30,0" Background="#EEE"/>

                <Grid Grid.Row="3" Margin="30,25,30,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding GoBackCommand}"
                            Content="Back"
                            Width="100"
                            Height="45"
                            Background="White"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            Foreground="#555"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,0,15,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="1"
                            Content="Book Now"
                            Height="45"
                            Background="#007ACC"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#005fa3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>