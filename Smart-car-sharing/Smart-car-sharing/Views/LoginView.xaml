<UserControl x:Class="SmartCarSharingApp.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:SmartCarSharingApp.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="400">

    <!-- Підключаємо ViewModel -->
    <UserControl.DataContext>
        <viewModels:LoginViewModel />
    </UserControl.DataContext>

    <Grid Background="#F5F5F5">
        <Border Background="White" 
                CornerRadius="10" 
                Padding="30" 
                Width="350" 
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Вхід" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <!-- Email -->
                <TextBlock Text="Електронна пошта" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Height="30"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,15"
                         Padding="5"/>

                <!-- Password -->
                <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="30"
                             Margin="0,0,0,20"
                             Padding="5"
                             PasswordChanged="PasswordBox_OnPasswordChanged"/>

                <Button Content="Увійти"
                        Height="35"
                        Background="#007ACC"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Command="{Binding LoginCommand}"
                        Margin="0,0,0,15"/>

                <!-- Navigation -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Немає акаунту? " Foreground="Gray"/>
                    <TextBlock>
                        <Hyperlink Click="NavigateToRegister_Click">
                            Зареєструватися
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
