<UserControl x:Class="SmartCarSharingApp.UI.Views.CarCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:SmartCarSharing.Core;assembly=SmartCarSharing.Core"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="200">

    <!-- Це для попереднього перегляду у Visual Studio (щоб ви бачили дані, а не пусту картку) -->
    <d:UserControl.DataContext>
        <core:Car Make="Tesla" Model="Model 3" PricePerHour="45" Year="2023" Location="Київ, Центр"/>
    </d:UserControl.DataContext>

    <Grid Margin="10">
        <!-- Біла картка з тінню -->
        <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="3" Direction="270"/>
            </Border.Effect>

            <!-- ГОЛОВНА СІТКА: Розбиває картку на 3 поверхи -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <!-- 0: Місце для картинки (фіксоване) -->
                    <RowDefinition Height="*"/>
                    <!-- 1: Текст (розтягується) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Кнопка (знизу) -->
                </Grid.RowDefinitions>

                <!-- 1. Верхня частина: Картинка (Row 0) -->
                <Border Grid.Row="0" 
                        Background="#F5F7FA" 
                        CornerRadius="12,12,0,0" 
                        ClipToBounds="True">
                    <Grid>
                        <!-- Іконка машини -->
                        <TextBlock Text="🚗" 
                                   FontSize="50" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Opacity="0.8"/>

                        <!-- Рік випуску (маленький бейдж справа зверху) -->
                        <Border Background="White" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Margin="8" 
                                CornerRadius="4" 
                                Padding="6,2">
                            <TextBlock Text="{Binding Year}" FontSize="10" FontWeight="Bold" Foreground="Gray"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Середня частина: Інформація (Row 1) -->
                <!-- Змінено StackPanel на DockPanel, щоб правильно притиснути ціну до низу -->
                <DockPanel Grid.Row="1" Margin="12,10,12,5" LastChildFill="False">

                    <!-- Ціна (DockPanel.Dock="Bottom" гарантує, що вона буде знизу блоку) -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="$" FontSize="14" FontWeight="Bold" Foreground="#007ACC"/>
                        <TextBlock Text="{Binding PricePerHour}" FontSize="18" FontWeight="Bold" Foreground="#007ACC"/>
                        <TextBlock Text="/год" FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                    </StackPanel>

                    <!-- Назва та локація (DockPanel.Dock="Top" притискає до верху) -->
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Назва авто -->
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run Text="{Binding Make}" FontWeight="Bold" FontSize="16" Foreground="#333"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Model}" FontSize="16" Foreground="#555"/>
                        </TextBlock>

                        <!-- Локація -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📍" FontSize="10" Margin="0,1,3,0"/>
                            <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                    </StackPanel>

                </DockPanel>

                <!-- 3. Нижня частина: Кнопка (Row 2) -->
                <Button Grid.Row="2" 
                        Content="Деталі" 
                        Margin="12,0,12,12" 
                        Height="32"
                        Background="#007ACC" 
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="DetailsButton_Click">
                    <!-- Шаблон кнопки, щоб вона була заокруглена -->
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>